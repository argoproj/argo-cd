{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "Update the Renovate docker image pinned in the `renovate-image`/`renovate-version` inputs of `renovatebot/github-action`. The action passes `<renovate-image>:<renovate-version>` to `docker run`, so a `<tag>@sha256:<digest>` version keeps the image fully pinned. Both inputs must be on adjacent lines.",
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/renovate.yaml"
      ],
      "matchStrings": [
        "renovate-image:\\s*[\"']?(?<packageName>[^\"'\\s]+)[\"']?\\s+renovate-version:\\s*[\"']?(?<currentValue>[^\"'\\s@]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
